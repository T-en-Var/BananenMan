generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LegacyXpImport {
  id         Int      @id @default(autoincrement())
  guildId    String
  userId     String
  textXp     Decimal  @default(0) @db.Decimal(14, 3)
  voiceXp    Decimal  @default(0) @db.Decimal(14, 3)
  importedAt DateTime @default(now())

  @@unique([guildId, userId])
}

enum XpSource {
  VOICE_MINUTE
  TEXT_MESSAGE
}

model XpEvent {
  id         BigInt   @id @default(autoincrement())
  guildId    String
  userId     String
  source     XpSource
  amount     Decimal  @default(1) @db.Decimal(10, 3)
  channelId  String?
  occurredAt DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, occurredAt])
}
