BOT_TOKEN=uwu
CLIENT_ID=123
aap=aap

# Postgres (used by docker-compose.yml's `postgres` service)
POSTGRES_USER=bananenman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bananenman

# Connection string used by Prisma. When running the bot via docker-compose,
# the host is the `postgres` service name (see docker-compose.yml). For local
# (non-Docker) dev with `npm run dev`, or for a host-side client like pgAdmin,
# point this at localhost on the published port (5433, see docker-compose.yml) instead:
# DATABASE_URL=postgresql://bananenman:changeme@localhost:5433/bananenman
DATABASE_URL=postgresql://bananenman:changeme@postgres:5432/bananenman
